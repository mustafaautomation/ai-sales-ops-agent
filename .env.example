# Copy to .env. No real secrets belong in this repo.
# The values below are for the local demo only.

LLM_PROVIDER=mock
# openai | anthropic | openai-compatible | mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EMAIL_API_URL=http://127.0.0.1:4001
CRM_API_URL=http://127.0.0.1:4002

DATABASE_PATH=./data/meridian.db

# Cookie signing secret. Change it if the desk is reachable by anyone else.
SESSION_SECRET=dev-only-session-secret

# Set to false to hide the one-click demo login.
DEMO_MODE=true

# Public form: requests per IP per window.
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW_MS=600000

# Copy to .env. No real secrets belong in this repo.
# The values below are for the local demo only.

LLM_PROVIDER=mock
# mock | openai | anthropic | openai-compatible | workers-ai
# workers-ai runs only inside the Cloudflare Worker, via the AI binding.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
WORKERS_AI_MODEL=@cf/openai/gpt-oss-120b
WORKERS_AI_FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Worker-only Gemini fallback after Workers AI 4006 / 5xx / timeout. Key is a Worker secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Local mock inbox only. The worker does not read this; approved mail stays in the sandbox outbox.
EMAIL_API_URL=http://127.0.0.1:4001
CRM_API_URL=http://127.0.0.1:4002

# Local, Docker, and CI SQLite file. Leave unset on Vercel when WORKER_URL is set.
DATABASE_PATH=./data/meridian.db

# Cookie signing secret. Change it if the desk is reachable by anyone else.
SESSION_SECRET=dev-only-session-secret

# Set to false to hide the one-click demo login.
DEMO_MODE=true

# Public form: requests per IP per window.
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW_MS=600000

# Production console talks to the Worker. Leave unset for local SQLite.
WORKER_URL=
WORKER_AUTH_TOKEN=

# Voice. No key is written into the page source.
VAPI_SECRET=local-vapi-secret
VAPI_ASSISTANT_ID=
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ORG_ID=
PUBLIC_ORIGIN=https://sales.quvantic.com
RATE_LIMIT_SALT=local-salt
MCP_BEARER_TOKEN=

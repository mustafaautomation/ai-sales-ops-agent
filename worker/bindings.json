{
  "d1_databases": [
    { "binding": "DB", "database_name": "meridian", "database_id": "replace-after-create" }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "services": [{ "binding": "SELF", "service": "meridian-desk" }],
  "vars": {
    "LLM_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/openai/gpt-oss-120b",
    "WORKERS_AI_FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODEL": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
    "PUBLIC_ORIGIN": "https://sales.quvantic.com"
  },
  "secrets": [
    "WORKER_AUTH_TOKEN",
    "MCP_BEARER_TOKEN",
    "VAPI_SECRET",
    "VAPI_PRIVATE_KEY",
    "VAPI_ORG_ID",
    "VAPI_PUBLIC_KEY",
    "VAPI_ASSISTANT_ID",
    "RATE_LIMIT_SALT",
    "GEMINI_API_KEY"
  ]
}
